{
  "name": "NOVARA",
  "install": "python3 -m pip install --user -r requirements.txt",
  "ports": [
    {
      "name": "web",
      "port": 8000
    }
  ],
  "terminals": [
    {
      "name": "web",
      "command": "python3 server.py",
      "description": "NOVARA static site + /api/readings (NOVARAReadings) + /api/sites (NOVARASites). Open http://localhost:8000/sites.html"
    }
  ]
}
